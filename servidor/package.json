{
  "name": "servidor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/servidor.ts",
    "start": "tsx src/servidor.ts",
    "migrar": "tsx --env-file-if-exists=.env src/migrar.ts",
    "publicar": "tsx --env-file-if-exists=.env src/publicar.ts",
    "publicar:produccion": "tsx --env-file=.env.produccion src/publicar.ts",
    "test": "tsx --test src/*.test.ts",
    "comprobar": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
